<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFF6FF"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvFragmentA"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="To jest Fragment A"
        android:textColor="#1E40AF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <EditText
        android:id="@+id/etMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Wpisz wiadomość do Fragmentu B"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvFragmentA"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnSendToB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wyślij do Fragment B"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/etMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>